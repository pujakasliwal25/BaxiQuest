# Copy to .env.local and fill in from your Firebase project's web app config.
# All five values are required for Firestore. If any are missing, the app
# falls back to localStorage so progress still persists per-browser.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
