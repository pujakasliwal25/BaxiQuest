rules_version = '2';

// Firestore security rules for BAXI Quest.
//
// IMPORTANT: This app has no real authentication yet — the "login" is just
// a typed class code. That means we can't tie reads/writes to a Firebase
// Auth uid. The best we can do at this layer is:
//
//  1. Allow access only to the two collections the app actually uses.
//  2. Constrain the shape of writes so a malicious client can't dump
//     arbitrary documents into the project.
//  3. Cap field counts and string lengths so a vandal can't burn quota.
//
// When real auth lands, tighten these rules to require
// `request.auth != null` and `request.auth.uid == userKey` (or similar).
// Until then, treat the database as semi-public — only data the app
// already exposes in the UI.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users collection ───────────────────────────────────────────────
    // Each doc id is `<CLASSCODE>_<lowercased_name>` (see buildUserKey).
    // The admin view reads the whole collection; an individual student
    // reads + writes only their own doc.
    match /users/{userKey} {
      allow read: if true;

      allow create, update: if isValidUserDoc(request.resource.data)
                         && userKey.size() <= 120
                         && userKey.size() > 0;

      // No client-side delete — admin "Reset all" deletes through the same
      // path as a write, but a vandal shouldn't be able to nuke arbitrary
      // users. If you want admins to delete, build that path through a
      // Cloud Function with auth.
      allow delete: if false;
    }

    // ── Leaderboard entries ────────────────────────────────────────────
    // Doc id format: `<cellKey>__<userKey>` (deterministic so the same
    // user/cell pair overwrites instead of appending).
    match /leaderboardEntries/{entryId} {
      allow read: if true;
      allow create, update: if isValidLeaderboardEntry(request.resource.data);
      allow delete: if false;
    }

    // Anything outside the two known collections is rejected.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// ── Validators ───────────────────────────────────────────────────────────

function isString(v, maxLen) {
  return v is string && v.size() <= maxLen;
}

function isOptionalNumber(v) {
  return !('exists' in v) || v == null || v is number;
}

function isValidUserDoc(d) {
  // Required surface: name, classCode, curriculumLevel.
  // Everything else is structural — the app may be evolving the shape, so
  // we keep this loose but capped.
  return d.keys().size() <= 12
      && (!('name' in d) || isString(d.name, 80))
      && (!('classCode' in d) || isString(d.classCode, 32))
      && (!('curriculumLevel' in d) || isString(d.curriculumLevel, 8))
      && (!('coins' in d) || (d.coins is number && d.coins <= 10000000))
      && (!('progress' in d) || d.progress is map)
      && (!('cellStats' in d) || d.cellStats is map);
}

function isValidLeaderboardEntry(d) {
  return d.keys().size() <= 10
      && (!('name' in d) || isString(d.name, 80))
      && (!('userKey' in d) || isString(d.userKey, 120))
      && (!('cellKey' in d) || isString(d.cellKey, 64))
      && (!('digitType' in d) || isString(d.digitType, 32))
      && (!('curriculumLevel' in d) || isString(d.curriculumLevel, 8))
      && (!('numberCount' in d) || (d.numberCount is number && d.numberCount <= 100))
      && (!('avgMs' in d) || (d.avgMs is number && d.avgMs >= 0))
      && (!('achievedAt' in d) || d.achievedAt is number);
}
