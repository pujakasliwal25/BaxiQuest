rules_version = '2';

// Firestore security rules for BAXI Quest.
//
// Now that real auth is in place (Firebase Auth, email/password under the
// hood with username → synthetic email mapping), reads/writes are gated
// on `request.auth != null`. Admin-only operations check the synthetic
// email against an allowlist that mirrors the ADMIN_USERNAMES constant
// in src/services/authStore.ts. To grant admin to additional usernames,
// update both this file AND that constant, then redeploy + republish
// rules.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      // Synthetic emails look like `<username>@baxiquest.app`. Compare on
      // the email so we don't have to maintain a uid allowlist (uids are
      // assigned at signup and not knowable in advance).
      return isSignedIn()
        && request.auth.token.email == 'baxiadmin@baxiquest.app';
    }
    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ── Users collection ───────────────────────────────────────────────
    // Doc id = Firebase uid. A student reads/writes only their own doc.
    // Admins can read every user (for the admin dashboard) but writes are
    // self-only — we never want admins silently rewriting someone's
    // progress.
    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create, update: if isSelf(uid)
                         && isValidUserDoc(request.resource.data);
      allow delete: if isAdmin();
    }

    // ── Classes ────────────────────────────────────────────────────────
    // Anyone signed in can list classes (used for class-code lookup
    // during join). Only admins can create / modify / delete.
    match /classes/{classId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin()
                                 && isValidClassDoc(request.resource.data);
    }

    // ── Leaderboard entries ────────────────────────────────────────────
    // Doc id format: `<cellKey>__<userKey>`. Anyone signed in can read
    // (for the leaderboard view). A student writes only their own entry —
    // we use the userKey embedded in the id and document body.
    match /leaderboardEntries/{entryId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
                         && isValidLeaderboardEntry(request.resource.data)
                         && request.resource.data.userKey == request.auth.uid;
      allow delete: if isAdmin();
    }

    // Anything outside the three known collections is rejected.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// ── Validators ───────────────────────────────────────────────────────────

function isString(v, maxLen) {
  return v is string && v.size() <= maxLen;
}

function isValidUserDoc(d) {
  return d.keys().size() <= 14
      && (!('name' in d) || isString(d.name, 80))
      && (!('username' in d) || isString(d.username, 32))
      && (!('classId' in d) || d.classId == null || isString(d.classId, 64))
      && (!('curriculumLevel' in d) || isString(d.curriculumLevel, 8))
      && (!('coins' in d) || (d.coins is number && d.coins <= 10000000))
      && (!('progress' in d) || d.progress is map)
      && (!('cellStats' in d) || d.cellStats is map);
}

function isValidClassDoc(d) {
  return d.keys().size() <= 8
      && (!('name' in d) || isString(d.name, 80))
      && (!('code' in d) || isString(d.code, 16))
      && (!('curriculumLevel' in d) || isString(d.curriculumLevel, 8))
      && (!('createdByUid' in d) || isString(d.createdByUid, 64));
}

function isValidLeaderboardEntry(d) {
  return d.keys().size() <= 10
      && (!('name' in d) || isString(d.name, 80))
      && (!('userKey' in d) || isString(d.userKey, 120))
      && (!('cellKey' in d) || isString(d.cellKey, 64))
      && (!('digitType' in d) || isString(d.digitType, 32))
      && (!('curriculumLevel' in d) || isString(d.curriculumLevel, 8))
      && (!('numberCount' in d) || (d.numberCount is number && d.numberCount <= 100))
      && (!('avgMs' in d) || (d.avgMs is number && d.avgMs >= 0))
      && (!('achievedAt' in d) || d.achievedAt is number);
}
